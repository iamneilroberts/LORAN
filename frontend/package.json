{
  "name": "adsb-viz-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cesium:assets": "node -e \"const f=require('fs');['Workers','Assets','Widgets','ThirdParty'].forEach(d=>f.cpSync('node_modules/cesium/Build/Cesium/'+d,'public/cesium/'+d,{recursive:true}))\"",
    "dev": "npm run cesium:assets && vite",
    "build": "npm run cesium:assets && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cesium": "^1.124.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
