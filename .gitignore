# Secrets
.env
.env.local

# Archive database (Phase 5), and the raw place-marker downloads (scripts/build_places.py).
# Leading slash is load-bearing: a bare "data/" matches a directory of that name at ANY depth,
# which silently swallowed the GENERATED and committed frontend/src/data/places.json.
/data/
*.db
*.db-wal
*.db-shm

# Node
# No trailing slashes: a trailing slash matches directories only, so it misses the
# symlinked node_modules / .venv that isolated worktrees use to share deps.
node_modules
dist
# `dist` alone does not match this one: the single-file build writes to dist-single/, and an
# 11 MB generated HTML file is exactly the kind of thing that gets committed by accident (D-070).
dist-single
.vite

# Python
__pycache__/
*.py[cod]
.venv
venv
*.egg-info/
.pytest_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Build artefacts — regenerated, never committed
# ---------------------------------------------------------------------------

# CesiumJS ships Workers/Assets/Widgets/ThirdParty that must be served as static files.
# `npm run cesium:assets` copies them out of node_modules on every dev/build, so they are
# pure build output. 389 files, ~7.8 MB — tracked by accident, because the Node section
# above only covered dist/ and node_modules/.
frontend/public/cesium/

# Generated mockup artifacts - regenerate with scripts/build_mockup_assets.py
# (they embed a live-traffic snapshot and go stale; the generator is the durable thing)
docs/mockups/assets.json
docs/mockups/index.html
