# LORAN configuration — copy to .env and fill in.
# .env is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# Identity — REQUIRED
# ---------------------------------------------------------------------------
# planespotters.net returns HTTP 403 unless the User-Agent carries a contact
# URL or email. This is a hard requirement of their API, not a nicety.
# Format: appname/version (+mailto:you@example.com)
LORAN_USER_AGENT=loran/0.1 (+mailto:you@example.com)

# ---------------------------------------------------------------------------
# Home location — default camera target
# ---------------------------------------------------------------------------
LORAN_HOME_LAT=30.6944
LORAN_HOME_LON=-88.0399
LORAN_HOME_LABEL=Mobile, AL

# ---------------------------------------------------------------------------
# ADS-B — no keys required for any of these
# ---------------------------------------------------------------------------
LORAN_ADSB_PRIMARY=airplanes.live
LORAN_ADSB_FALLBACK=adsb.lol
# Upstream limit is 1 req/sec (airplanes.live). Do not raise without reading
# their terms — this is a volunteer-funded, non-commercial service.
LORAN_ADSB_POLL_SECONDS=2
# /point radius is capped at 250 nm upstream.
LORAN_ADSB_MAX_RADIUS_NM=250

# ---------------------------------------------------------------------------
# adsbdb — registration / type / operator / route. No key required.
# No published rate limit, so these caps are our own politeness budget.
# ---------------------------------------------------------------------------
# Airframe data is static per hull.
LORAN_ADSBDB_TTL_SECONDS=86400
# Routes change per flight.
LORAN_ADSBDB_ROUTE_TTL_SECONDS=3600
# How long a "not in adsbdb" answer is remembered before asking again.
LORAN_ADSBDB_MISS_TTL_SECONDS=3600
# Minimum gap between upstream adsbdb calls.
LORAN_ADSBDB_MIN_INTERVAL_SECONDS=0.2

# ---------------------------------------------------------------------------
# AIS — Phase 4, gated on a coverage measurement. Leave blank until then.
# Free key via GitHub sign-in at https://aisstream.io
# ---------------------------------------------------------------------------
AISSTREAM_API_KEY=

# ---------------------------------------------------------------------------
# Cesium ion — NOT REQUIRED. We run keyless by design (decisions.md D-003).
# Only set this if you later want 3D land terrain or true seafloor geometry.
# ---------------------------------------------------------------------------
CESIUM_ION_TOKEN=

# ---------------------------------------------------------------------------
# Archive — Phase 5
# ---------------------------------------------------------------------------
LORAN_DB_PATH=./data/archive.db
# "rolling" keeps a fixed time window; "budget" grows until the disk cap.
LORAN_RETENTION_MODE=rolling
LORAN_RETENTION_HOURS=48
LORAN_DISK_BUDGET_GB=20

# ---------------------------------------------------------------------------
# planespotters photo JSON cache. Image BYTES are never cached or proxied
# (D-009) — the browser loads those from their CDN. 24 h is a hard cap.
# ---------------------------------------------------------------------------
LORAN_PHOTO_TTL_SECONDS=86400
LORAN_PHOTO_MISS_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Track ring buffer (D-016) — in memory, lost on restart. Phase 5 makes it
# durable. The UI always states the window it actually holds.
# ---------------------------------------------------------------------------
LORAN_TRACK_WINDOW_SECONDS=1800
# One sample per contact per this many seconds. Below the poll interval this
# just stores near-duplicate points without covering more time.
LORAN_TRACK_SAMPLE_SECONDS=5
LORAN_TRACK_MAX_CONTACTS=3000

# ---------------------------------------------------------------------------
# Weather radar (D-040) — OFF by default in the UI. Reverses the "no weather"
# non-goal on owner instruction. NEXRAD base reflectivity, US coverage only;
# outside the US the layer is simply transparent.
#
# VITE_ prefix is mandatory: it is the only way Vite exposes a variable to
# browser code. These are read at BUILD time, not runtime.
# ---------------------------------------------------------------------------
# Iowa State Mesonet's WMS render of NOAA/NWS NEXRAD. Free, no key.
VITE_RADAR_WMS=https://mesonet.agron.iastate.edu/cgi-bin/wms/nexrad/n0q.cgi
# The -900913 suffix is IEM's web-mercator render; it matches Cesium's tiling
# scheme so the server is not reprojecting every tile.
VITE_RADAR_LAYER=nexrad-n0q-900913
# Frames publish about every 5 minutes. The layer rebuilds on this interval
# while visible so a stale frame is never left on screen looking live.
VITE_RADAR_REFRESH_MS=300000
# Translucent so radar reads as an overlay, never as the basemap.
VITE_RADAR_ALPHA=0.55
# Radar is ~1 km data; past this zoom level tiles are upscaling and imply
# precision the source does not have.
VITE_RADAR_MAX_LEVEL=10

# ---------------------------------------------------------------------------
# Remote access (D-041) — see docs/remote-access.md for the full runbook.
#
# EMPTY = no access control, which is correct for a localhost-only instance and
# WRONG for anything reachable from the internet. Setting tokens turns the door
# on; it is a shared secret, not an account system.
#
# Mint one per person so you can revoke one without disturbing the other:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
LORAN_ACCESS_TOKENS=
# Which principal in the list above is you. Only matters for owner-only features.
LORAN_OWNER_PRINCIPAL=owner
# Optional. Unset derives the cookie key from the tokens, so sessions survive a
# restart and rotating a token revokes that token's sessions.
LORAN_SESSION_SECRET=
LORAN_SESSION_TTL_SECONDS=2592000
# Where the built frontend lives, so the API process can serve it from one origin.
#
# LEAVE THIS COMMENTED OUT. scripts/serve.sh sets it to ./frontend/dist for you,
# and the Docker image sets it to /app/static. Uncommenting it EMPTY is worse than
# omitting it: docker compose passes the empty value through env_file and it
# overrides the image's own setting, so the container serves the API with no app
# behind it and / returns 404. Only set it if you are serving a build from some
# other path by hand.
# LORAN_STATIC_DIR=
# planespotters clause 8 forbids re-exposing their API. FALSE (the default) gives
# guests the honest no-photo state while the owner still gets photos. Setting it
# true is a deliberate departure from those terms — see D-041.
LORAN_PHOTO_GUEST_ACCESS=false
